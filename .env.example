# Copy to .env for local runs. Never commit a real .env (it is gitignored).
# In DEMO mode every value below has a safe default.
APP_ENV=demo                     # demo | dev | prod
JWT_SECRET=                      # required when APP_ENV != demo (openssl rand -hex 32)
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false              # true in prod (HTTPS only)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_SEED=20260928
DATABASE_URL=sqlite:///data/profitpilot.db
MODEL_PATH=data/models/v1.json
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SIM=60/minute
RATE_LIMIT_DEFAULT=300/minute
MAX_PRICE_MOVE=0.12
ALLOW_FAULTS=true                # demo-only: ?fault=model_unavailable exercises error states
LOG_LEVEL=INFO
